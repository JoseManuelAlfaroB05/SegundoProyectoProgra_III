                </constraints>
                <properties>
                  <text value="Categoría"/>
                </properties>
              </component>
              <component id="b2003" class="javax.swing.JLabel" binding="labelId">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="ID"/>
                </properties>
              </component>
              <component id="b2004" class="javax.swing.JTextField" binding="textFieldId">
                <constraints>
                  <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="4" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
