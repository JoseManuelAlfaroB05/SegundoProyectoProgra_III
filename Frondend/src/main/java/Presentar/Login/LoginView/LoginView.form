<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="Presentar.Login.LoginView.LoginView">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="3" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="626" height="490"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>

      <vspacer id="topSpacer">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>

      <hspacer id="leftSpacer">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </hspacer>

      <grid id="centralPanel" binding="centralPanel" layout-manager="GridLayoutManager" row-count="4" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="15" vgap="15">
        <margin top="25" left="30" bottom="25" right="30"/>
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="400" height="250"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>

          <component id="userLabel" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Usuario:"/>
            </properties>
          </component>

          <component id="56de1" class="javax.swing.JTextField" binding="UserTextField">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="220" height="30"/>
              </grid>
            </constraints>
            <properties/>
          </component>

          <component id="dc0f2" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Contraseña:"/>
            </properties>
          </component>

          <grid id="passwordPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>

              <component id="afd07" class="javax.swing.JPasswordField" binding="passwordField">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="185" height="30"/>
                  </grid>
                </constraints>
                <properties>
                  <text value=""/>
                </properties>
              </component>

              <component id="c240e" class="javax.swing.JButton" binding="restaurarPass">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                    <preferred-size width="35" height="30"/>
                  </grid>
                </constraints>
                <properties>
                  <margin top="0" left="0" bottom="0" right="0"/>
                  <text value="🔄"/>
                  <toolTipText value="Restaurar contraseña"/>
                </properties>
              </component>

            </children>
          </grid>

          <grid id="buttonPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="15" vgap="-1">
            <margin top="10" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>

              <component id="f6cb7" class="javax.swing.JButton" binding="btnIngresar">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false">
                    <preferred-size width="110" height="35"/>
                  </grid>
                </constraints>
                <properties>
                  <margin top="0" left="0" bottom="0" right="0"/>
                  <text value="✅"/>
                  <toolTipText value="Ingresar"/>
                </properties>
              </component>

              <component id="390d8" class="javax.swing.JButton" binding="btnRechazar">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false">
                    <preferred-size width="110" height="35"/>
                  </grid>
                </constraints>
                <properties>
                  <margin top="0" left="0" bottom="0" right="0"/>
                  <text value="❌"/>
                  <toolTipText value="Cancelar"/>
                </properties>
              </component>

            </children>
          </grid>

          <vspacer id="formSpacer">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
            </constraints>
          </vspacer>

        </children>
      </grid>

      <hspacer id="rightSpacer">
        <constraints>
          <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </hspacer>

      <vspacer id="bottomSpacer">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>

    </children>
  </grid>
</form>